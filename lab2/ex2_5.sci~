clc;
clear;
clf();

n = -1:1;
x = [1 3 -2];

x_minus_n = x($:-1:1);

xe = (x + x_minus_n) / 2;
xo = (x - x_minus_n) / 2;

subplot(3,1,1);
plot2d3(n, x);
xtitle("x(n)", "n", "Amplitude");

subplot(3,1,2);
plot2d3(n, xo);
xtitle("Odd component x_o(n)", "n", "Amplitude");

subplot(3,1,3);
plot2d3(n, xe);
xtitle("Even component x_e(n)", "n", "Amplitude");
